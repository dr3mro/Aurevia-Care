PROJECT_NAME           = "$(DOC_PROJECT_NAME)"
OUTPUT_DIRECTORY       = build/developer-reference
INPUT                  = docs/reference apps/api
FILE_PATTERNS          = *.java *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */target/* */build/* */src/test/* */node_modules/*
USE_MDFILE_AS_MAINPAGE = docs/reference/index.md
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_FROM_PATH        = .
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
HAVE_DOT               = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
