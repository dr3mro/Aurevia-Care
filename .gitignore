.env
.env.*
node_modules/
target/
dist/
coverage/
.expo/
*.log
.DS_Store

/build/
# Local scratch only: worker notes are tracked under .agents/notes/, never under .agent/pr-notes/.
/.agent/*
/.agent/pr-notes/

# Tooling and editors
__pycache__/
*.pyc
.venv/
.idea/
.vscode/
*.tar

# Credentials and infrastructure state: never commit
*.pem
*.key
*.p12
*.pfx
*.tfstate
*.tfstate.*
*.tfvars
.terraform/

# Database dumps and local data can contain patient data
*.dump
*.bak
*.sql.gz
!.env.example

# Stryker mutation testing output (opt-in npm run mutation)
apps/*/.stryker-tmp/
apps/*/reports/mutation/

# Generated from tasks/ by scripts/taskstore.py; not stored in git
/TODO.md

# Local PR worktrees created by gh_pr_workspace / gh_pr_fix_conflict
/.workspaces/

# Generated scratch files must live under build/, never the repo root
/_*.txt
/_*.log
/_out*
/_final*
