{
  "name": "smartclinic-staff-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SmartClinic staff web visual foundation (synthetic data only).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude 'e2e/**'",
    "test:coverage": "vitest run --coverage --exclude 'e2e/**'",
    "mutation": "stryker run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "gen:api": "bash scripts/gen-api-types.sh",
    "gen:api:check": "bash scripts/gen-api-types.sh --check",
    "docs": "typedoc --options typedoc.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "6.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "15.14.0",
    "jiti": "^2.6.1",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "typedoc": "0.27.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
