{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.config.ts"
  },
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "App.tsx",
    "index.ts",
    "app.config.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!**/*.d.ts"
  ],
  "reporters": ["clear-text", "html"],
  "thresholds": { "high": 80, "low": 60, "break": null },
  "timeoutMS": 60000
}